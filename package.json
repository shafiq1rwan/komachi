{
  "name": "komachi",
  "version": "0.3.1",
  "description": "A cosy, retro-flavoured city diorama. Zone homes, shops and workplaces and watch a little town come alive.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src && node scripts/check-comments.mjs",
    "test": "node scripts/test-progression.mjs && node scripts/smoke.mjs",
    "test:architecture": "node scripts/check-architecture.mjs",
    "preview:architecture": "node scripts/preview-architecture.mjs",
    "app": "electron .",
    "app:check": "node scripts/check-electron.mjs",
    "app:build": "vite build && electron-builder --win",
    "app:build:linux": "vite build && electron-builder --linux",
    "build:poki": "vite build --mode poki",
    "pack:poki": "node scripts/pack-poki.mjs",
    "check:poki": "node scripts/check-poki.mjs",
    "build:demo": "vite build --mode demo",
    "check:demo": "node scripts/check-demo.mjs",
    "pack:demo": "node scripts/pack-poki.mjs dist-demo output/demo/komachi-demo.zip"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "puppeteer-core": "^23.0.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "town.komachi.app",
    "productName": "Komachi",
    "copyright": "Copyright © 2026 Saiss",
    "directories": {
      "output": "release",
      "buildResources": "public/icons"
    },
    "files": [
      "dist/**",
      "electron/**",
      "public/icons/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Komachi",
      "artifactName": "Komachi-${version}-setup.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icons/icon-512.png",
      "category": "Game",
      "artifactName": "Komachi-${version}-linux.${ext}"
    },
    "portable": {
      "artifactName": "Komachi-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "shafiq1rwan",
      "repo": "komachi",
      "releaseType": "draft"
    }
  },
  "license": "UNLICENSED",
  "author": "Saiss"
}
